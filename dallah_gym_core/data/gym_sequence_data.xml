<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_gym_member_code" model="ir.sequence">
        <field name="name">Gym Member Code</field>
        <field name="code">gym.member.code</field>
        <field name="prefix">GYM-%(year)s-</field>
        <field name="padding">4</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_gym_membership" model="ir.sequence">
        <field name="name">Gym Membership</field>
        <field name="code">gym.membership</field>
        <field name="prefix">MEM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
