<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gym_membership_list" model="ir.ui.view">
        <field name="name">gym.membership.list</field>
        <field name="model">gym.membership</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-info="state == 'frozen'"
                  decoration-danger="state in ('expired', 'cancelled')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="branch_id" optional="show"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="coach_id" optional="show"/>
                <field name="amount_paid" sum="Total" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"
                       decoration-info="state == 'frozen'" decoration-danger="state in ('expired', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="view_gym_membership_form" model="ir.ui.view">
        <field name="name">gym.membership.form</field>
        <field name="model">gym.membership</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,frozen,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="branch_id"/>
                            <field name="allowed_branch_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="days_remaining"/>
                            <field name="coach_id" invisible="membership_type == 'gym'"/>
                            <field name="pt_slot_hour" widget="float_time" invisible="membership_type == 'gym'"/>
                            <field name="membership_type" invisible="1"/>
                            <field name="is_frozen" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Accounting">
                            <field name="amount_paid"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="sale_line_id" readonly="1" invisible="not sale_line_id"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="refund_move_id" readonly="1" invisible="not refund_move_id"/>
                        </group>
                        <group/>
                    </group>
                    <notebook>
                        <page string="PT Sessions" name="pt_sessions" invisible="membership_type == 'gym'">
                            <field name="pt_session_ids" readonly="1">
                                <list>
                                    <field name="session_number"/>
                                    <field name="session_date"/>
                                    <field name="start_hour" widget="float_time"/>
                                    <field name="coach_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Freeze History" name="freeze_history">
                            <field name="freeze_log_ids" readonly="1">
                                <list>
                                    <field name="freeze_start_date"/>
                                    <field name="freeze_end_date"/>
                                    <field name="freeze_days"/>
                                    <field name="reason"/>
                                    <field name="processed_by"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gym_membership_search" model="ir.ui.view">
        <field name="name">gym.membership.search</field>
        <field name="model">gym.membership</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="coach_id"/>
                <filter name="active_ms" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="frozen" string="Frozen" domain="[('state', '=', 'frozen')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                <filter name="group_product" string="Plan" context="{'group_by': 'product_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_gym_membership" model="ir.actions.act_window">
        <field name="name">Memberships</field>
        <field name="res_model">gym.membership</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_ms': 1}</field>
    </record>
</odoo>
