<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_branch_list" model="ir.ui.view">
        <field name="name">res.branch.list</field>
        <field name="model">res.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="analytic_account_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_res_branch_form" model="ir.ui.view">
        <field name="name">res.branch.form</field>
        <field name="model">res.branch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Izghawa Men's Gym"/></h1>
                    </div>
                    <group name="main">
                        <group>
                            <field name="code" placeholder="e.g. BBM"/>
                            <field name="analytic_account_id"/>
                            <field name="warehouse_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group name="gate_policy" string="Turnstile Access Policy">
                        <field name="default_allowed_branch_ids" widget="many2many_checkboxes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_users_form_gym_branch" model="ir.ui.view">
        <field name="name">res.users.form.gym.branch</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Gym Branches" name="gym_branches">
                    <group>
                        <field name="gym_branch_ids" widget="many2many_checkboxes"/>
                    </group>
                    <div class="text-muted">Cashiers and receptionists only see memberships, PT sessions and check-ins of these branches. Gym Managers see all branches.</div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_res_branch" model="ir.actions.act_window">
        <field name="name">Gym Branches</field>
        <field name="res_model">res.branch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
