<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_gym" model="ir.module.category">
        <field name="name">Gym Management</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_gym" model="res.groups.privilege">
        <field name="name">Gym</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_gym"/>
    </record>

    <record id="group_gym_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Front-desk counter cashier: sells memberships, sees own branch data only.</field>
    </record>

    <record id="group_gym_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <field name="implied_ids" eval="[(4, ref('group_gym_cashier'))]"/>
        <field name="comment">Branch receptionist: manages PT schedule, freezes, check-ins of own branches.</field>
    </record>

    <record id="group_gym_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_gym"/>
        <field name="implied_ids" eval="[(4, ref('group_gym_receptionist'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Back-office manager: global visibility across all branches, refunds and ZKBio overrides.</field>
    </record>

</odoo>
